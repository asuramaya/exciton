# Exciton — example environment file. Copy to .env and fill in.
# Anything referenced as ${VAR} in config.toml is resolved from here at startup.
# Never commit your actual .env — it is in .gitignore.

# ── RPC providers ─────────────────────────────────────────────
# At least one of these is required. Stack multiple for failover.
HELIUS_API_KEY=
ALCHEMY_API_KEY=
QUICKNODE_API_KEY=

# ── Wallet ────────────────────────────────────────────────────
# Public key (Solana base58 address). Required when [madapes] or
# [execution] is enabled — used for wallet snapshots and PnL math.
EXCITON_WALLET_PUBLIC_KEY=

# Private key — ONLY needed if [execution].enabled = true.
# Solana keypair as a JSON byte array (the format `solana-keygen` outputs).
# Strongly recommended: load this from your OS keychain instead.
# EXCITON_PRIVATE_KEY=

# ── Telegram ──────────────────────────────────────────────────
# Channel poster bot.
TELEGRAM_BOT_TOKEN=
# Optional separate bot for the DM long-poll. Recommended.
TELEGRAM_DM_BOT_TOKEN=
# Chat IDs (negative integers for channels, e.g. -1001234567890).
TELEGRAM_SIGNALS_CHAT_ID=
TELEGRAM_OPS_CHAT_ID=

# ── /claw LLM agent (optional) ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Publisher target ──────────────────────────────────────────
# Absolute path to a local staging directory where JSON snapshots
# are bundled before being POSTed to the Cloudflare Worker.
# Required when [madapes].enabled = true.
MADAPES_REPO_PATH=

# Cloudflare Worker endpoint that receives signed publisher POSTs.
# E.g. https://madapesai.com/api/admin/publish
CF_PUBLISH_URL=

# HMAC-SHA256 shared secret. Must match `wrangler secret put PUBLISH_SECRET`
# on the Worker side. Generate with `openssl rand -hex 32`.
CF_PUBLISH_SECRET=

# ── Runtime knobs ─────────────────────────────────────────────
# Override the SQLite path. Default: ./exciton.db
# EXCITON_DB_PATH=

# Set to "1" to skip starting the MCP server.
# EXCITON_DISABLE_MCP=
